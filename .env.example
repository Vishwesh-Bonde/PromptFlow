# Copy this file to `.env` and adjust values as needed.
# The app runs fully in mock mode with no API key.

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

MOCK_STREAM_DELAY_MS=40
MOCK_STREAM_CHUNK_CHARS=24
# Optional deterministic mock failures; leave blank/comment out for success.
MOCK_INITIAL_DELAY_MS=0
# MOCK_FAILURE_AFTER_CHUNKS=0

DATABASE_PATH=./data/promptflow.db
INSTRUCTION_DEBOUNCE_MS=250
CHECKPOINT_INTERVAL_MS=500

MAX_PROMPT_CHARS=12000
MAX_INSTRUCTION_CHARS=6000
MAX_INSTRUCTIONS_PER_TASK=100

PROVIDER_TIMEOUT_SECONDS=120
CANCELLATION_TIMEOUT_SECONDS=5

SSE_QUEUE_SIZE=256
SSE_HEARTBEAT_SECONDS=15
